#!/bin/sh
# prerm script for emailclaw
#
# see: dh_installdeb(1)

set -e

case "$1" in
    remove|deconfigure)
        # Determine the installing user
        INSTALL_USER="${SUDO_USER:-}"
        if [ -z "$INSTALL_USER" ] || [ "$INSTALL_USER" = "root" ]; then
            INSTALL_USER="$(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $3}' | grep -vx root | sort -u | head -n1)"
        fi
        [ -n "$INSTALL_USER" ] || INSTALL_USER="$(getent passwd | awk -F: '$3 >= 1000 {print $1; exit}')"

        if [ -n "$INSTALL_USER" ]; then
            USER_HOME="$(eval echo "~$INSTALL_USER" 2>/dev/null || true)"
            [ -n "$USER_HOME" ] || USER_HOME="$(getent passwd "$INSTALL_USER" | cut -d: -f6)"
            [ -n "$USER_HOME" ] || USER_HOME="/home/$INSTALL_USER"

            echo "=========================================================="
            echo " [emailclaw] Stopping and unregistering per-user background service..."

            uid="$(id -u "$INSTALL_USER" 2>/dev/null || true)"
            if [ -n "$uid" ]; then
                if command -v runuser >/dev/null 2>&1; then
                    runuser -u "$INSTALL_USER" -- sh -c \
                        "XDG_RUNTIME_DIR=/run/user/$uid systemctl --user disable --now emailclaw 2>/dev/null; \
                         XDG_RUNTIME_DIR=/run/user/$uid systemctl --user daemon-reload 2>/dev/null" || true
                else
                    su -s /bin/sh "$INSTALL_USER" -c \
                        "XDG_RUNTIME_DIR=/run/user/$uid systemctl --user disable --now emailclaw 2>/dev/null; \
                         XDG_RUNTIME_DIR=/run/user/$uid systemctl --user daemon-reload 2>/dev/null" || true
                fi
            fi

            rm -f "$USER_HOME/.config/systemd/user/emailclaw.service" 2>/dev/null || true
            rm -f "$USER_HOME/.local/bin/emailclaw" 2>/dev/null || true
            rm -f "$USER_HOME/.local/share/applications/emailclaw-emailclaw.desktop" 2>/dev/null || true

            echo " [emailclaw] Service unregistered."
            echo "=========================================================="
        fi
    ;;

    upgrade|failed-upgrade)
        # Determine the installing user
        INSTALL_USER="${SUDO_USER:-}"
        if [ -z "$INSTALL_USER" ] || [ "$INSTALL_USER" = "root" ]; then
            INSTALL_USER="$(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $3}' | grep -vx root | sort -u | head -n1)"
        fi
        [ -n "$INSTALL_USER" ] || INSTALL_USER="$(getent passwd | awk -F: '$3 >= 1000 {print $1; exit}')"

        if [ -n "$INSTALL_USER" ]; then
            uid="$(id -u "$INSTALL_USER" 2>/dev/null || true)"
            if [ -n "$uid" ]; then
                echo " [emailclaw] Stopping per-user background service for upgrade..."
                if command -v runuser >/dev/null 2>&1; then
                    runuser -u "$INSTALL_USER" -- sh -c "XDG_RUNTIME_DIR=/run/user/$uid systemctl --user stop emailclaw 2>/dev/null" || true
                else
                    su -s /bin/sh "$INSTALL_USER" -c "XDG_RUNTIME_DIR=/run/user/$uid systemctl --user stop emailclaw 2>/dev/null" || true
                fi
            fi
        fi
    ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
