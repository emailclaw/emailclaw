<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ai.emailclaw.emailclaw.plugin.samples</groupId>
  <artifactId>emailclaw-plugin-samples</artifactId>
  <version>1.0.1</version>
  <packaging>pom</packaging>
  <name>Emailclaw Plugin Samples Reactor</name>
  <description>Multi-module reactor example that resolves the local emailclaw module directly.</description>

  <properties>
    <emailclaw.version>26.10.28</emailclaw.version>
    <agentscope.version>2.0.4</agentscope.version>
    <jackson.databind.version>3.2.4</jackson.databind.version>
    <jackson.core.version>3.2.4</jackson.core.version>
    <jackson.annotations.version>2.22</jackson.annotations.version>
    <dingtalk.stream.version>1.3.12</dingtalk.stream.version>
    <junit.jupiter.version>6.1.3</junit.jupiter.version>
    <spotless.version>3.10.4</spotless.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.jupiter.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>ai.emailclaw</groupId>
        <artifactId>emailclaw</artifactId>
        <version>${emailclaw.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>io.agentscope</groupId>
        <artifactId>agentscope-core</artifactId>
        <version>${agentscope.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>tools.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.databind.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>tools.jackson.core</groupId>
        <artifactId>jackson-core</artifactId>
        <version>${jackson.core.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-annotations</artifactId>
        <version>${jackson.annotations.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>com.dingtalk.open</groupId>
        <artifactId>dingtalk-stream</artifactId>
        <version>${dingtalk.stream.version}</version>
        <scope>compile</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.6</version>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <executions>
            <execution>
              <goals>
                <goal>check</goal>
              </goals>
              <phase>compile</phase>
            </execution>
          </executions>
          <configuration>
            <encoding>UTF-8</encoding>
            <java>
              <removeUnusedImports />
              <forbidWildcardImports />
              <formatAnnotations />
              <importOrder />
              <googleJavaFormat>
                <style>AOSP</style>
                <reflowLongStrings>true</reflowLongStrings>
                <formatJavadoc>false</formatJavadoc>
              </googleJavaFormat>
            </java>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <modules>
    <module>../emailclaw</module>
    <module>dingtalk</module>
    <module>invokeAntigravityCli</module>
    <module>invokeOpencodeCli</module>
    <module>invokeCodexCli</module>
    <module>invokeClaudeCodeCli</module>
  </modules>
</project>
