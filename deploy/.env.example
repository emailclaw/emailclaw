# ==============================================================================
# Emailclaw Docker Compose Environment Variables
# ==============================================================================

# Release version to deploy (e.g. latest, v26.10.21)
EMAILCLAW_VERSION=latest

# GitHub repository (for forks or custom mirrors)
EMAILCLAW_REPO=emailclaw/emailclaw

# Container timezone (e.g. UTC, Asia/Shanghai, America/New_York)
TZ=Asia/Shanghai

# JVM memory and Garbage Collection parameters
JAVA_OPTS=-Xms256m -Xmx1024m -XX:+UseG1GC
